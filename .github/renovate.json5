{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  timezone: "America/New_York",
  dependencyDashboard: true,
  ignorePaths: [
    "kubernetes/apps/iot/zoo-fleet/app/ocirepository.yaml",
  ],
  pruneStaleBranches: true,
  prHourlyLimit: 10,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  packageRules: [
    {
      description: "GitHub Actions tool inputs are version-only",
      matchManagers: ["github-actions"],
      matchPackageNames: ["helm/helm", "sigstore/cosign"],
      pinDigests: false,
    },
    {
      description: "Plane auth helper image is coupled to the chart planeVersion",
      matchManagers: ["kubernetes"],
      matchFileNames: ["kubernetes/apps/services/plane/app/helmrelease.yaml"],
      matchPackageNames: ["makeplane/backend-commercial"],
      enabled: false,
    },
    {
      description: "Helmfile OCI charts do not support synthesized digest fields",
      matchManagers: ["helmfile"],
      matchFileNames: ["talos/helmfile.yaml"],
      pinDigests: false,
    },
  ],
  // Avoid mass rebasing every Renovate branch each run. Those updates fan out
  // GitHub Actions jobs and overload the self-hosted ARC dind runner.
  rebaseWhen: "conflicted",
  // Renovate is deny-by-default. Narrow package rules may opt in only exact,
  // low-risk dependencies after their release-age and CI gates pass.
  automerge: false,
  automergeStrategy: "squash",
  platformAutomerge: false,
  // Renovate PRs rely on automated checks and must not request human reviews.
  reviewers: [],
  additionalReviewers: [],
  reviewersFromCodeOwners: false,
  assigneesFromCodeOwners: false,
  extends: [
    "config:best-practices",
    "github>shamubernetes/home-k8s//.github/renovate/fileMatch.json5",
    "github>shamubernetes/home-k8s//.github/renovate/noPin.json5",
    "github>shamubernetes/home-k8s//.github/renovate/customDatasources.json5",
    "github>shamubernetes/home-k8s//.github/renovate/customManagers.json5",
    "github>shamubernetes/home-k8s//.github/renovate/packageRules.json5",
    "github>shamubernetes/home-k8s//.github/renovate/commitmessages.json5",
  ],
  labels: ["renovate"],
  // config:best-practices waits three days by default. Only Talos and
  // Kubernetes releases are delayed by the narrower package rule below.
  minimumReleaseAge: "0 days",
  hostRules: [
    {
      matchHost: "https://grafana.com/api/",
      concurrentRequestLimit: 1,
      maxRequestsPerSecond: 1,
    },
  ],
  prCreation: "immediate",
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },
}
