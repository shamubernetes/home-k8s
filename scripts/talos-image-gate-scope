#!/usr/bin/env python3
"""Classify whether a PR includes Talos application image changes."""

from __future__ import annotations

import re
import sys

NON_APPLICATION = re.compile(
    r"^kubernetes/apps/(actions-runner-system|kyverno)/"
)


def main() -> int:
    files = [line.strip() for line in sys.stdin if line.strip()]
    applicable = any(
        path.startswith("kubernetes/") and NON_APPLICATION.match(path) is None
        for path in files
    )
    print("applicable" if applicable else "not-applicable")
    return 0


if __name__ == "__main__":
    sys.exit(main())
