{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Kanvil is managed by the opt-in fast-update lane",
      "matchDatasources": ["docker"],
      "matchFileNames": ["kubernetes/apps/services/kanvil/app/helmrelease.yaml"],
      "matchPackageNames": ["ghcr.io/maudecode/kanvil"],
      "allowedVersions": "/^experimental$/",
      "versioning": "docker",
      "enabled": false
    },
    {
      "description": "The Talaria feedback bridge is managed by the opt-in fast-update lane",
      "matchDatasources": ["docker"],
      "matchFileNames": ["kubernetes/apps/services/talaria-feedback-bridge/app/helmrelease.yaml"],
      "matchPackageNames": ["ghcr.io/maudecode/talaria-feedback-bridge"],
      "enabled": false
    }
  ]
}
