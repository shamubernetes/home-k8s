#!/usr/bin/env python3
"""Resolve an image and record an explicit runtime contract before scaffolding an app."""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

TEXT_NAMES = {
    "docker-compose.yml",
    "docker-compose.yaml",
    "compose.yml",
    "compose.yaml",
    "dockerfile",
    "containerfile",
    "docker-entrypoint.sh",
    "entrypoint.sh",
}
TEXT_SUFFIXES = {
    ".cs",
    ".env",
    ".go",
    ".js",
    ".json",
    ".py",
    ".sh",
    ".toml",
    ".ts",
    ".yaml",
    ".yml",
}
LOCK_NAMES = {"cargo.lock", "package-lock.json", "pnpm-lock.yaml", "yarn.lock"}
DATABASE_TOKENS = {
    "postgres": ("postgres", "postgresql", "npgsql"),
    "mysql": ("mysql", "mariadb"),
    "sqlite": ("sqlite",),
    "embedded": ("embedded",),
    "none": (),
}


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(
        description="Preflight a new GitOps app without guessing its runtime contract"
    )
    value.add_argument("app", help="application path as <category>/<app>")
    value.add_argument("--image", required=True, help="image:tag or immutable image@sha256 digest")
    value.add_argument("--port", required=True, type=int)
    health = value.add_mutually_exclusive_group(required=True)
    health.add_argument("--health-path")
    health.add_argument("--no-health-endpoint", action="store_true")
    value.add_argument(
        "--persistence",
        required=True,
        help="none or a comma-separated list of container paths",
    )
    value.add_argument(
        "--database",
        required=True,
        choices=("none", "postgres", "mysql", "sqlite", "embedded"),
    )
    value.add_argument(
        "--auth",
        required=True,
        choices=("internal", "browser-oidc", "split-api", "public"),
    )
    value.add_argument("--source", type=Path, help="optional upstream source checkout to inspect")
    value.add_argument(
        "--strict-evidence",
        action="store_true",
        help="fail when declared runtime values are not found in the supplied source",
    )
    value.add_argument("--json", action="store_true", help="emit only JSON")
    return value


def run(command: list[str]) -> str:
    completed = subprocess.run(command, check=True, text=True, capture_output=True)
    return completed.stdout.strip()


def resolve_image(image: str, repo_root: Path) -> str:
    if "@sha256:" in image:
        if ":" not in image.rsplit("/", 1)[-1].split("@", 1)[0]:
            raise ValueError("digest-pinned images must preserve the tag as image:tag@sha256:...")
        if not re.fullmatch(r"[a-fA-F0-9]{64}", image.rsplit("@sha256:", 1)[-1]):
            raise ValueError("sha256 digest must contain exactly 64 hexadecimal characters")
        return image
    if ":" not in image.rsplit("/", 1)[-1]:
        raise ValueError("image must include a tag or sha256 digest")
    command = os.environ.get("PIN_IMAGE_BIN", str(repo_root / "scripts" / "pin-image"))
    resolved = run([command, image])
    digest = resolved.rsplit("@", 1)[-1]
    if not re.fullmatch(r"sha256:[a-fA-F0-9]{64}", digest):
        raise ValueError(f"pin-image returned an invalid digest reference: {resolved}")
    return f"{image}@{digest}"


def crane_metadata(image: str) -> tuple[dict[str, Any], list[str]]:
    crane = os.environ.get("CRANE_BIN") or shutil.which("crane")
    if not crane:
        return {}, ["crane is unavailable; registry platform and container config inspection was skipped"]
    warnings: list[str] = []
    metadata: dict[str, Any] = {}
    try:
        manifest = json.loads(run([crane, "manifest", image]))
        platforms = []
        for item in manifest.get("manifests", []):
            platform = item.get("platform", {})
            if (
                platform.get("os")
                and platform.get("architecture")
                and platform.get("os") != "unknown"
                and platform.get("architecture") != "unknown"
            ):
                platforms.append(
                    "/".join(
                        part
                        for part in (
                            platform.get("os"),
                            platform.get("architecture"),
                            platform.get("variant"),
                        )
                        if part
                    )
                )
        metadata["platforms"] = sorted(set(platforms))
    except (subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        warnings.append(f"could not inspect image manifest with crane: {exc}")
    try:
        config_document = json.loads(run([crane, "config", image]))
        config = config_document.get("config", config_document)
        metadata["entrypoint"] = config.get("Entrypoint") or []
        metadata["command"] = config.get("Cmd") or []
        metadata["exposedPorts"] = sorted((config.get("ExposedPorts") or {}).keys())
        metadata["volumes"] = sorted((config.get("Volumes") or {}).keys())
        metadata["environmentNames"] = sorted(
            item.split("=", 1)[0] for item in config.get("Env") or [] if "=" in item
        )
    except (subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        warnings.append(f"could not inspect image config with crane: {exc}")
    return metadata, warnings


def source_documents(source: Path) -> dict[str, str]:
    if not source.is_dir():
        raise ValueError(f"source directory does not exist: {source}")
    documents: dict[str, str] = {}
    for path in source.rglob("*"):
        if not path.is_file() or any(part in {".git", "node_modules", "vendor"} for part in path.parts):
            continue
        lowered = path.name.lower()
        if lowered in LOCK_NAMES:
            continue
        if lowered not in TEXT_NAMES and path.suffix.lower() not in TEXT_SUFFIXES:
            continue
        try:
            if path.stat().st_size > 512_000:
                continue
            documents[str(path.relative_to(source))] = path.read_text(errors="replace")
        except OSError:
            continue
    return documents


def evidence(documents: dict[str, str], needles: list[str]) -> list[str]:
    if not needles:
        return []
    matches = []
    patterns = []
    for needle in needles:
        escaped = re.escape(needle.lower())
        if needle.startswith("/"):
            patterns.append(re.compile(escaped + r"(?![a-z0-9_.-])"))
        elif needle.isdigit():
            patterns.append(re.compile(r"(?<!\d)" + escaped + r"(?!\d)"))
        else:
            patterns.append(re.compile(r"(?<![a-z0-9])" + escaped + r"(?![a-z0-9])"))
    for name, text in documents.items():
        lowered = text.lower()
        if any(pattern.search(lowered) for pattern in patterns):
            matches.append(name)
    return sorted(matches)


def main() -> int:
    args = parser().parse_args()
    if not re.fullmatch(
        r"[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?",
        args.app,
    ):
        print("app must be <category>/<app> using lowercase DNS labels", file=sys.stderr)
        return 2
    if any(len(part) > 63 for part in args.app.split("/")):
        print("app category and name must be at most 63 characters", file=sys.stderr)
        return 2
    if not 1 <= args.port <= 65535:
        print("port must be between 1 and 65535", file=sys.stderr)
        return 2
    if args.health_path is not None and not args.health_path.startswith("/"):
        print("health path must be an absolute HTTP path", file=sys.stderr)
        return 2
    if args.strict_evidence and args.source is None:
        print("--strict-evidence requires --source", file=sys.stderr)
        return 2
    persistence = [] if args.persistence == "none" else [item.strip() for item in args.persistence.split(",") if item.strip()]
    if args.persistence != "none" and (not persistence or any(not path.startswith("/") for path in persistence)):
        print("persistence must be none or comma-separated absolute container paths", file=sys.stderr)
        return 2

    repo_root = Path(__file__).resolve().parents[1]
    try:
        resolved_image = resolve_image(args.image, repo_root)
        image_metadata, warnings = crane_metadata(resolved_image)
    except (ValueError, subprocess.CalledProcessError) as exc:
        print(f"image preflight failed: {exc}", file=sys.stderr)
        return 1

    exposed_ports = image_metadata.get("exposedPorts") or []
    if exposed_ports and not any(item.split("/", 1)[0] == str(args.port) for item in exposed_ports):
        warnings.append(
            f"declared port {args.port} does not match image exposed ports: {', '.join(exposed_ports)}"
        )
    image_volumes = image_metadata.get("volumes") or []
    if not persistence and image_volumes:
        warnings.append(
            "persistence is declared none but the image declares volumes: "
            + ", ".join(image_volumes)
        )

    source_result: dict[str, Any] | None = None
    missing_evidence: list[str] = []
    if args.source:
        try:
            documents = source_documents(args.source)
        except ValueError as exc:
            print(str(exc), file=sys.stderr)
            return 2
        source_result = {
            "filesInspected": len(documents),
            "port": evidence(documents, [str(args.port)]),
            "health": evidence(documents, [args.health_path]) if args.health_path else [],
            "persistence": {path: evidence(documents, [path]) for path in persistence},
            "database": evidence(documents, list(DATABASE_TOKENS[args.database])),
        }
        if not source_result["port"]:
            missing_evidence.append(f"port {args.port}")
        if args.health_path and not source_result["health"]:
            missing_evidence.append(f"health path {args.health_path}")
        for path, matches in source_result["persistence"].items():
            if not matches:
                missing_evidence.append(f"persistence path {path}")
        if args.database != "none" and not source_result["database"]:
            missing_evidence.append(f"database {args.database}")
        warnings.extend(f"no upstream source evidence found for {item}" for item in missing_evidence)
    else:
        warnings.append("no upstream source checkout supplied; declared runtime contract was not source-verified")

    result = {
        "app": args.app,
        "image": resolved_image,
        "runtime": {
            "port": args.port,
            "healthPath": args.health_path,
            "persistence": persistence,
            "database": args.database,
            "auth": args.auth,
        },
        "imageMetadata": image_metadata,
        "sourceEvidence": source_result,
        "warnings": warnings,
        "scaffoldCommand": (
            f"scripts/new-app {args.app.replace('/', ' ', 1)} --image {resolved_image} "
            f"--port {args.port} "
            + (f"--health-path {args.health_path}" if args.health_path else "--no-health-endpoint")
            + " --internal"
        ),
        "followUp": [
            item
            for item in (
                "add persistent storage and backup policy for: " + ", ".join(persistence)
                if persistence
                else None,
                f"add {args.database} database initialization and secret wiring"
                if args.database != "none"
                else None,
                "add split browser/API routes and native API-key verification"
                if args.auth == "split-api"
                else "add browser OIDC policy and callback client"
                if args.auth == "browser-oidc"
                else None,
            )
            if item is not None
        ],
    }
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print(f"app: {args.app}")
        print(f"image: {resolved_image}")
        print(f"port: {args.port}")
        print(f"health: {args.health_path or 'explicitly none'}")
        print(f"persistence: {', '.join(persistence) if persistence else 'none'}")
        print(f"database: {args.database}")
        print(f"auth: {args.auth}")
        print(f"scaffold: {result['scaffoldCommand']}")
        for item in result["followUp"]:
            print(f"follow-up: {item}")
        for warning in warnings:
            print(f"warning: {warning}", file=sys.stderr)
    return 2 if args.strict_evidence and missing_evidence else 0


if __name__ == "__main__":
    raise SystemExit(main())
