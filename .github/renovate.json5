{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  timezone: 'America/New_York',
  dependencyDashboard: {
    enabled: true,
  },
  ignorePaths: [
    'kubernetes/apps/iot/zoo-fleet/app/ocirepository.yaml',
  ],
  pruneStaleBranches: true,
  prHourlyLimit: 10,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  packageRules: [
    {
      description: 'Rook must preserve the pinned CSI imageSet',
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'kubernetes/apps/rook-ceph/rook-ceph/app/helmrelease.yaml',
        'kubernetes/apps/rook-ceph/rook-ceph/app/ocirepository.yaml',
        'kubernetes/apps/rook-ceph/rook-ceph/cluster/ocirepository.yaml',
      ],
      matchPackageNames: [
        'ghcr.io/rook/rook-ceph',
        'ghcr.io/rook/rook-ceph-cluster',
        'docker.io/rook/ceph',
      ],
      allowedVersions: '<1.21.0',
    },
    {
      description: 'Renovate 44.131.1 through 44.132.1 have an unresolvable published npm dependency',
      matchManagers: [
        'mise',
      ],
      matchFileNames: [
        '.mise.toml',
      ],
      matchPackageNames: [
        'renovate',
      ],
      allowedVersions: '!/^44\\.(131\\.[1-4]|132\\.[01])$/',
    },
    {
      description: 'Python 3.14.8 has no checksum-verified standalone binaries yet',
      matchManagers: [
        'mise',
      ],
      matchFileNames: [
        '.mise.toml',
      ],
      matchPackageNames: [
        'python/cpython',
      ],
      allowedVersions: '!/^3\\.14\\.8$/',
    },
    {
      description: 'Ceph CSI operator must match the Rook bundled CRD API',
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'kubernetes/apps/rook-ceph/rook-ceph/app/helmrelease.yaml',
      ],
      matchPackageNames: [
        'quay.io/cephcsi/ceph-csi-operator',
      ],
      allowedVersions: '<1.1.0',
    },
    {
      description: 'GitHub Actions tool inputs are version-only',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        'helm/helm',
        'sigstore/cosign',
      ],
      pinDigests: false,
    },
    {
      description: 'Cloudflare Wrangler Action v4.1.0 and v4.1.1 are missing their built entrypoint',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        'cloudflare/wrangler-action',
      ],
      allowedVersions: '!/^v4\\.1\\.[01]$/',
    },
    {
      description: 'Plane auth helper image is coupled to the chart planeVersion',
      matchManagers: [
        'kubernetes',
      ],
      matchFileNames: [
        'kubernetes/apps/services/plane/app/helmrelease.yaml',
      ],
      matchPackageNames: [
        'makeplane/backend-commercial',
      ],
      enabled: false,
    },
    {
      description: 'Freeze Firecrawl schema helper digest after registry oscillation',
      matchManagers: [
        'helm-values',
        'kubernetes',
      ],
      matchFileNames: [
        'kubernetes/apps/tools/firecrawl/app/init-nuq-schema-job.yaml',
      ],
      matchPackageNames: [
        'docker.io/library/postgres',
      ],
      enabled: false,
    },
    {
      description: 'Preserve the accepted OpenViking original-proof image',
      matchManagers: [
        'kubernetes',
        'helm-values',
      ],
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'kubernetes/apps/tools/openviking/backup-native/original-native-job.yaml',
        'kubernetes/apps/tools/openviking/backup-native/original-native-r2-job.yaml',
      ],
      matchPackageNames: [
        'ghcr.io/volcengine/openviking',
      ],
      matchCurrentValue: '0.2.12',
      matchJsonata: [
        "currentDigest = 'sha256:23bfcc83f941e92d5bbf71dd5626d4a46e2173043c5ae68317778da47d42fb6d'",
      ],
      enabled: false,
    },
    {
      description: 'Helmfile OCI charts do not support synthesized digest fields',
      matchManagers: [
        'helmfile',
      ],
      matchFileNames: [
        'talos/helmfile.yaml',
      ],
      pinDigests: false,
    },
  ],
  rebaseWhen: 'conflicted',
  automerge: false,
  automergeStrategy: 'squash',
  platformAutomerge: false,
  reviewers: [],
  additionalReviewers: [],
  reviewersFromCodeOwners: false,
  assigneesFromCodeOwners: false,
  extends: [
    'config:best-practices',
    'github>shamubernetes/home-k8s//.github/renovate/fileMatch.json5',
    'github>shamubernetes/home-k8s//.github/renovate/noPin.json5',
    'github>shamubernetes/home-k8s//.github/renovate/customDatasources.json5',
    'github>shamubernetes/home-k8s//.github/renovate/customManagers.json5',
    'github>shamubernetes/home-k8s//.github/renovate/commitmessages.json5',
    'github>shamubernetes/home-k8s//.github/renovate/packageRules.json5',
    'github>shamubernetes/home-k8s//kubernetes/apps/renovate/renovate/app/config/fast-updates.json',
  ],
  labels: [
    'renovate',
  ],
  minimumReleaseAge: '0 days',
  hostRules: [
    {
      matchHost: 'https://grafana.com/api/',
      concurrentRequestLimit: 1,
      maxRequestsPerSecond: 1,
    },
  ],
  prCreation: 'immediate',
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
}
