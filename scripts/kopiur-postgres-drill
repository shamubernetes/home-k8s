#!/usr/bin/env python3
"""Offline PostgreSQL + PVC fixtures and verified-bundle recovery.

No Kubernetes commands. Containers share a network-none namespace, publish no
ports, and receive only disposable credentials. Source backups are read-only.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import secrets
import subprocess
import tempfile
import tarfile
import io
import threading
import time
import uuid
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parents[1]
CAPTURE = ROOT / "kubernetes/components/kopiur-postgres/capture.sh"
RADARR_QUIESCE = ROOT / "scripts/kopiur-radarr-quiesce"
RADARR_RECURRING = ROOT / "scripts/kopiur-radarr-recurring"
PG_IMAGE = "postgres:17@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675"
RADARR_IMAGE = "ghcr.io/home-operations/radarr:6.4.4.10685@sha256:be53998a2d39cfa3c3315b70c7509a6a1f2a10c3aee9337653efc9f4c970430e"
PAIRED_APPS = ("bazarr", "radarr")
CONTRACTS = {
    "radarr": (RADARR_IMAGE, ["radarr_main"], "RADARR", 7878, "/config/config.xml"),
    "radarr-3d": (RADARR_IMAGE, ["radarr_3d_main"], "RADARR", 7878, "/config/config.xml"),
    "sonarr": ("ghcr.io/home-operations/sonarr:4.0.20.3012@sha256:1f19eb5e0f421418c1a956bbe01310a0141423afe28bd9a4b1dcb8629ff2bce2", ["sonarr_main"], "SONARR", 7878, "/config/config.xml"),
    "whisparr": ("ghcr.io/shamubernetes/whisparr-eros:3.3.7-release.979@sha256:9002dd8e29471d65f0b1a03802a3bf48bb58212435a053bbbe8971f2d2253194", ["whisparrv3_main", "whisparrv3_logs"], "WHISPARR", 7878, "/config/config.xml"),
    "bazarr": ("ghcr.io/home-operations/bazarr:1.6.2@sha256:17dc1cff22e99694ffbfb06555526cb47a66b362b4d6c982f06b557f7caae2bb", ["bazarr"], "BAZARR", 6767, "/config/config/config.yaml"),
}


def run(*args, stdin=None, check=True, timeout=180, env=None):
    result = subprocess.run(args, input=stdin, capture_output=True, timeout=timeout, env=env)
    if check and result.returncode:
        # Commands/env and database output may contain private data. Never echo them.
        raise RuntimeError(f"{args[0]} operation failed with exit {result.returncode}")
    return result


def verify_bundle(root):
    root = Path(root)
    if root.is_symlink() or any((root / name).is_symlink() for name in ("current", "COMPLETE", "current/SHA256SUMS")):
        raise ValueError("unsafe bundle path")
    if (root / "COMPLETE").read_text() != "complete\n":
        raise ValueError("bundle is incomplete")
    current = root / "current"
    expected = set()
    for line in (current / "SHA256SUMS").read_text().splitlines():
        digest, name = line.split("  ", 1)
        name = name.removeprefix("./")
        if Path(name).name != name or name in expected:
            raise ValueError("unsafe or duplicate artifact")
        path = current / name
        if path.is_symlink() or not path.is_file():
            raise ValueError("missing or unsafe artifact")
        with path.open("rb") as handle:
            actual = hashlib.file_digest(handle, "sha256").hexdigest()
        if actual != digest:
            raise ValueError("artifact checksum mismatch")
        expected.add(name)
    metadata = (current / "metadata").read_text().splitlines()
    databases = [line.split()[0].split("=", 1)[1] for line in metadata if line.startswith("database=")]
    if not databases or len(set(databases)) != len(databases):
        raise ValueError("missing or duplicate database inventory")
    required = {"application-config", "metadata"}
    coherent = "format=2" in metadata and "consistency=single-db-stable-filetree" in metadata
    if coherent:
        if len(databases) != 1:
            raise ValueError("coherent bundle contains multiple databases")
        required.update(("application-state.tar", "filetree.sha256"))
    for database in databases:
        if not database or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789_" for c in database):
            raise ValueError("unsafe database name")
        required.update((database + ".dump", database + ".toc"))
    if expected != required:
        raise ValueError("bundle inventory differs from metadata")
    if not coherent and ("format=1" not in metadata or "consistency=per-database-snapshot-before-pvc" not in metadata):
        raise ValueError("unsupported recovery contract")
    if coherent:
        fingerprint = (current / "filetree.sha256").read_text()
        if len(fingerprint) != 65 or fingerprint[-1] != "\n" or any(c not in "0123456789abcdef" for c in fingerprint[:-1]):
            raise ValueError("invalid filetree fingerprint")
        with tarfile.open(current / "application-state.tar", mode="r:") as archive:
            validate_tree_members(archive)
    return databases


def validate_tree_members(archive, capacity=None):
    names = set()
    total = 0
    for member in archive:
        path = Path(member.name)
        name = str(path)
        if path.is_absolute() or ".." in path.parts or name in names or \
                (path.parts and path.parts[0] == ".kopiur-postgres") or \
                not (member.isfile() or member.isdir()) or member.size < 0:
            raise ValueError("unsafe filetree archive member")
        names.add(name)
        total += member.size
        if capacity is not None and total > capacity:
            raise ValueError("filetree exceeds isolated restore capacity")
    if not names:
        raise ValueError("empty filetree archive")


class DockerDrill:
    def __init__(self, app="radarr", diagnostics=False, config_mib=256, database_mib=512, memory_mib=None):
        self.app_name = app
        self.image, self.databases, self.env_prefix, self.port, self.config_file = CONTRACTS[app]
        self.diagnostics = diagnostics
        self.config_mib, self.database_mib = config_mib, database_mib
        self.memory_mib = memory_mib
        self.prefix = "k8s92-pg-" + uuid.uuid4().hex[:10]
        self.containers = []
        self.volumes = []
        self.password = secrets.token_hex(24)
        self.backup_password = secrets.token_hex(32)
        self.capture_user = "kopiur_" + app.replace("-", "_")
        self.api_key = secrets.token_hex(16)

    def start(self, name, image, *, network="none", env=None, mounts=(), command=(), user=None, entrypoint=None):
        name = self.prefix + "-" + name
        args = ["docker", "run", "-d", "--name", name, "--network", network,
                "--label", "home-k8s.kopiur-postgres-drill=true", "--tmpfs", "/tmp:rw,size=268435456"]
        if self.memory_mib is not None:
            args += ["--memory", f"{self.memory_mib}m"]
        if image == PG_IMAGE:
            # Disposable databases need no Docker VM disk allocation or persistence.
            args += ["--tmpfs", f"/var/lib/postgresql/data:rw,size={self.database_mib}m"]
        if image != PG_IMAGE:
            args += ["--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges"]
        if image == CONTRACTS["whisparr"][0]:
            args += ["--platform", "linux/amd64"]
        if user:
            args += ["--user", user]
        if entrypoint:
            args += ["--entrypoint", entrypoint]
        process_env = os.environ.copy()
        for key, value in (env or {}).items():
            process_env[key] = value
            args += ["-e", key]
        for source, target, mode in mounts:
            if str(source).startswith(self.prefix):
                args += ["--mount", f"type=volume,src={source},dst={target},volume-nocopy" + (",readonly" if mode == "ro" else "")]
            else:
                args += ["-v", f"{source}:{target}:{mode}"]
        self.containers.append(name)
        result = run(*args, image, *command, env=process_env, check=False)
        if result.returncode:
            # Report actionable daemon capacity failures without echoing commands,
            # credentials, or application logs from a recovered production PVC.
            error = result.stderr.decode(errors="replace").lower()
            reason = next((message for message in ("no space left on device", "cannot allocate memory", "no such image")
                           if message in error), "daemon rejected container creation")
            raise RuntimeError(f"isolated container start failed: {reason} (exit {result.returncode})")
        return name

    def sql(self, container, sql, database="postgres", user="postgres", check=True):
        return run("docker", "exec", "-i", container, "psql", "-X", "-A", "-t", "-v",
                   "ON_ERROR_STOP=1", "-U", user, "-d", database, stdin=sql.encode(), check=check).stdout.decode().strip()

    def database(self, name, databases):
        container = self.start(name, PG_IMAGE, env={"POSTGRES_PASSWORD": self.password, "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256"})
        # The entrypoint's temporary init server is socket-only; wait for final TCP startup.
        for _ in range(90):
            if run("docker", "exec", container, "pg_isready", "-h", "127.0.0.1", "-U", "postgres", check=False).returncode == 0:
                break
            time.sleep(1)
        else:
            logs = run("docker", "logs", "--tail", "80", container, check=False)
            text = (logs.stdout + logs.stderr).decode(errors="replace").replace(self.password, "[redacted]")
            raise RuntimeError("isolated PostgreSQL startup timed out: " + text)
        self.sql(container, f"CREATE ROLE app LOGIN PASSWORD '{self.password}';\n"
                 f"CREATE ROLE backup LOGIN PASSWORD '{self.backup_password}';")
        for database in databases:
            self.sql(container, f'CREATE DATABASE "{database}" OWNER app;')
        return container

    def app(self, name, database, config, *, quiesce_until=None, recurring_state=None):
        prefix = self.env_prefix
        env = {f"{prefix}__POSTGRES__HOST": "127.0.0.1", f"{prefix}__POSTGRES__PORT": "5432",
               f"{prefix}__POSTGRES__USER": "app", f"{prefix}__POSTGRES__PASSWORD": self.password,
               f"{prefix}__POSTGRES__MAINDB": self.databases[0], f"{prefix}__LOG__DBENABLED": "False",
               f"{prefix}__SERVER__PORT": str(self.port), f"{prefix}__AUTH__APIKEY": self.api_key,
               f"{prefix}__AUTH__METHOD": "External", f"{prefix}__AUTH__REQUIRED": "DisabledForLocalAddresses"}
        if self.app_name == "whisparr":
            env = {"WHISPARR__POSTGRES_HOST": "127.0.0.1", "WHISPARR__POSTGRES_PORT": "5432",
                   "WHISPARR__POSTGRES_USER": "app", "WHISPARR__POSTGRES_PASSWORD": self.password,
                   "WHISPARR__POSTGRES_MAIN_DB": self.databases[0], "WHISPARR__POSTGRES_LOG_DB": self.databases[1],
                   "WHISPARR__PORT": str(self.port), "WHISPARR__API_KEY": self.api_key,
                   "WHISPARR__AUTHENTICATION_METHOD": "External", "WHISPARR__AUTHENTICATION_REQUIRED": "DisabledForLocalAddresses"}
        elif self.app_name == "bazarr":
            env = {"POSTGRES_ENABLED": "true", "POSTGRES_DATABASE": self.databases[0],
                   "POSTGRES_HOST": "127.0.0.1", "POSTGRES_PORT": "5432", "POSTGRES_USERNAME": "app",
                   "POSTGRES_PASSWORD": self.password, "BAZARR__API_KEY": self.api_key}
        quiescence = {}
        if quiesce_until is not None:
            if self.app_name != "radarr":
                raise ValueError("quiescence is qualified for Radarr only")
            entrypoint = json.loads(run("docker", "image", "inspect", "--format",
                                        "{{json .Config.Entrypoint}}", self.image).stdout)
            if entrypoint != ["/usr/bin/catatonit", "--", "/entrypoint.sh"]:
                raise ValueError("Radarr native entrypoint differs from reviewed image")
            env["QUIESCENCE_STATE_DIR"] = "/tmp/kopiur-quiescence"
            quiescence = {"entrypoint": entrypoint[0],
                          "command": ["--", "sh", "-c", RADARR_QUIESCE.read_text(),
                                      "kopiur-quiesce", "start", str(quiesce_until), entrypoint[-1]]}
        mounts = [(config, "/config", "rw")]
        if recurring_state is not None:
            if self.app_name != "radarr" or quiesce_until is not None:
                raise ValueError("recurring hold is qualified for Radarr only")
            entrypoint = json.loads(run("docker", "image", "inspect", "--format",
                                       "{{json .Config.Entrypoint}}", self.image).stdout)
            if entrypoint != ["/usr/bin/catatonit", "--", "/entrypoint.sh"]:
                raise ValueError("Radarr native entrypoint differs from reviewed image")
            env["QUIESCENCE_STATE_DIR"] = "/kopiur-quiescence"
            mounts.append((recurring_state, "/kopiur-quiescence", "rw"))
            quiescence = {"entrypoint": entrypoint[0],
                          "command": ["--", "sh", "-c", RADARR_RECURRING.read_text(),
                                      "kopiur-recurring", "supervise", entrypoint[-1]]}
        return self.start(name, self.image, network="container:" + database, user="568:568",
                          env=env, mounts=mounts, **quiescence)

    def check_quiescence(self, container, deadline, minimum=1):
        return run("docker", "exec", "-i", container, "sh", "-s", "check", str(deadline), str(minimum),
                   stdin=RADARR_QUIESCE.read_bytes(), check=False).returncode == 0

    def isolated_config(self, data):
        """Rewrite only a working copy. Never expose source DB/API credentials."""
        if self.app_name == "bazarr":
            env = os.environ.copy()
            env.update(DRILL_DB=self.databases[0], DRILL_PASSWORD=self.password, DRILL_API_KEY=self.api_key)
            expression = ('.postgresql = {"enabled": true, "host": "127.0.0.1", "port": 5432, '
                          '"database": strenv(DRILL_DB), "username": "app", '
                          '"password": strenv(DRILL_PASSWORD), "url": ""} | '
                          '.auth.apikey = strenv(DRILL_API_KEY)')
            return run("yq", expression, "-", stdin=data, env=env).stdout
        text = data.decode("utf-8")
        # Native ARR config is small UTF-8 XML. Reject DTD/entity declarations
        # before stdlib parsing rather than allowing archive-controlled expansion.
        if len(data) > 2 * 1024 * 1024 or any(token in text.upper() for token in ("<!DOCTYPE", "<!ENTITY")):
            raise ValueError("unsafe native XML config")
        tree = ET.fromstring(text)
        if tree.tag != "Config":
            raise ValueError("unexpected native XML config root")
        replacements = {"PostgresHost": "127.0.0.1", "PostgresPort": "5432", "PostgresUser": "app",
                        "PostgresPassword": self.password, "PostgresMainDb": self.databases[0],
                        "ApiKey": self.api_key, "Port": str(self.port), "AuthenticationMethod": "External",
                        "AuthenticationRequired": "DisabledForLocalAddresses"}
        if len(self.databases) > 1:
            replacements["PostgresLogDb"] = self.databases[1]
        for key, value in replacements.items():
            # Drop duplicate nodes rather than leaving an ambiguous source endpoint.
            for existing in tree.findall(key):
                tree.remove(existing)
            ET.SubElement(tree, key).text = value
        return ET.tostring(tree, encoding="utf-8", xml_declaration=True)

    def healthy(self, container):
        for _ in range(120):
            probe = run("docker", "exec", container, "curl", "-fsS", f"http://127.0.0.1:{self.port}/ping", check=False)
            if probe.returncode == 0:
                return
            state = run("docker", "inspect", "-f", "{{.State.Running}}", container).stdout.strip()
            if state != b"true":
                if not self.diagnostics:
                    raise RuntimeError("isolated application exited before readiness; logs withheld")
                logs = run("docker", "logs", "--tail", "80", container, check=False)
                text = (logs.stdout + logs.stderr).decode(errors="replace")
                for secret in (self.password, self.backup_password, self.api_key):
                    text = text.replace(secret, "[redacted]")
                raise RuntimeError("isolated fixture app exited before readiness: " + text)
            time.sleep(1)
        raise RuntimeError("isolated app startup timed out")

    def config_volume(self, name):
        name = self.prefix + "-" + name
        run("docker", "volume", "create", "--label", "home-k8s.kopiur-postgres-drill=true",
            "--driver", "local", "--opt", "type=tmpfs", "--opt", "device=tmpfs",
            "--opt", f"o=size={self.config_mib}m,uid=568,gid=568,mode=0700", name)
        self.volumes.append(name)
        return name

    def provision_bazarr_backup(self, database):
        """Keep the Bazarr entrypoint, exercising the same shared denial proof."""
        self.provision_scoped_backup(database, "bazarr")

    def provision_scoped_backup(self, container, database):
        """Exercise the shipped SQL with native schemas and deny probes."""
        script = ROOT / ("kubernetes/apps/arrs/kopiur-backup-identities/app/bazarr.sql"
                         if self.app_name == "bazarr"
                         else "kubernetes/apps/arrs/kopiur-backup-identities/app/provision.sql")
        role = self.capture_user
        env = os.environ.copy()
        env.update(BACKUP_USER=role, BACKUP_PASSWORD=self.backup_password,
                   APPLICATION_OWNER="app", APPLICATION_NAME=self.app_name)
        command = ("docker", "exec", "-i", "-e", "BACKUP_USER", "-e", "BACKUP_PASSWORD",
                   "-e", "APPLICATION_OWNER", "-e", "APPLICATION_NAME", container,
                   "psql", "-X", "-q", "-U", "postgres", "-d", database,
                   "-v", "ON_ERROR_STOP=1")
        if database == self.databases[0]:
            self.sql(container, f"CREATE ROLE {role} LOGIN")
            collision = run(*command, stdin=script.read_bytes(), env=env, check=False)
            assert collision.returncode, "provisioner claimed an unowned identity"
            self.sql(container, f"DROP ROLE {role}")
        for _ in range(2):
            result = run(*command, stdin=script.read_bytes(), env=env, check=False)
            if result.returncode:
                error = result.stderr.decode(errors="replace")
                for secret in (self.password, self.backup_password, self.api_key):
                    error = error.replace(secret, "[redacted]")
                raise RuntimeError("synthetic scoped grant SQL failed: " + error[:2000])
            assert not result.stdout.strip(), "provisioner printed credential-bearing settings"
        self.sql(container, "CREATE SEQUENCE kopiur_permission_sequence", database, "app")
        for acquire, revoke in (
                (f"ALTER ROLE {role} CREATEDB", f"ALTER ROLE {role} NOCREATEDB"),
                (f"GRANT app TO {role}", f"REVOKE app FROM {role}"),
                (f"GRANT INSERT ON kopiur_fixture TO {role}",
                 f"REVOKE INSERT ON kopiur_fixture FROM {role}"),
                (f"GRANT UPDATE(value) ON kopiur_fixture TO {role}", f"REVOKE UPDATE(value) ON kopiur_fixture FROM {role}"),
                (f"GRANT MAINTAIN ON kopiur_fixture TO {role}", f"REVOKE MAINTAIN ON kopiur_fixture FROM {role}"),
                (f"GRANT USAGE ON SEQUENCE kopiur_permission_sequence TO {role}", f"REVOKE USAGE ON SEQUENCE kopiur_permission_sequence FROM {role}"),
                (f"ALTER DEFAULT PRIVILEGES FOR ROLE app GRANT INSERT ON TABLES TO {role}", f"ALTER DEFAULT PRIVILEGES FOR ROLE app REVOKE INSERT ON TABLES FROM {role}"),
                ("ALTER DEFAULT PRIVILEGES FOR ROLE app IN SCHEMA public GRANT UPDATE ON TABLES TO PUBLIC", "ALTER DEFAULT PRIVILEGES FOR ROLE app IN SCHEMA public REVOKE UPDATE ON TABLES FROM PUBLIC")):
            self.sql(container, acquire, database)
            unsafe = run(*command, stdin=script.read_bytes(), env=env, check=False)
            assert unsafe.returncode, "provisioner accepted an elevated identity"
            self.sql(container, revoke, database)
        run(*command, stdin=script.read_bytes(), env=env)
        self.sql(container, "CREATE TABLE kopiur_future_fixture (id integer PRIMARY KEY);"
                 " INSERT INTO kopiur_future_fixture VALUES (1);", database, "app")
        assert self.sql(container, "SELECT count(*) FROM kopiur_future_fixture", database,
                        role) == "1", "future tables lack backup read grants"
        for sql in ("INSERT INTO kopiur_future_fixture VALUES (2)",
                    "UPDATE kopiur_future_fixture SET id=2", "DELETE FROM kopiur_future_fixture",
                    "CREATE TABLE unexpected_write (id integer)"):
            denied = run("docker", "exec", "-i", "-e", "PGOPTIONS=-c default_transaction_read_only=off",
                         container, "psql", "-X", "-U", role, "-d", database,
                         "-v", "ON_ERROR_STOP=1", stdin=sql.encode(), check=False)
            assert denied.returncode and b"permission denied" in denied.stderr, "backup acquired write authority"
        unrelated = "unrelated_fixture_" + database
        self.sql(container, f"CREATE DATABASE {unrelated} OWNER app")
        self.sql(container, "CREATE TABLE isolated_data (id integer); INSERT INTO isolated_data VALUES (1);",
                 unrelated, "app")
        denied = run("docker", "exec", "-i", container, "psql", "-X", "-U", role,
                     "-d", unrelated, "-v", "ON_ERROR_STOP=1",
                     stdin=b"SELECT * FROM isolated_data", check=False)
        assert denied.returncode and b"permission denied" in denied.stderr, "backup read unrelated data"

    def capture(self, database, config, databases, *, password=None, user=None, check=True):
        user = user or self.capture_user
        helper = self.start("capture-" + uuid.uuid4().hex[:6], PG_IMAGE,
                            network="container:" + database, user="568:568",
                            env={"PGHOST": "127.0.0.1", "PGUSER": user,
                                 "PGPASSWORD": password or self.backup_password, "PGDATABASES": " ".join(databases),
                                 "CAPTURE_MODE": "single-db-stable-filetree" if self.app_name in PAIRED_APPS else "legacy",
                                 "CONFIG_FILE": self.config_file},
                            mounts=[(config, "/config", "rw")], command=["sleep", "infinity"])
        result = run("docker", "exec", "-i", helper, "timeout", "600", "sh", "-s", stdin=CAPTURE.read_bytes(), check=False, timeout=610)
        if check and result.returncode:
            raise RuntimeError("fixture capture failed: " + result.stderr.decode().replace(self.backup_password, "[redacted]"))
        return result.returncode

    def restore(self, target, bundle, databases):
        verify_bundle(bundle)
        for database in databases:
            # No globals, roles, ACLs, tablespaces or ownership are imported.
            with (bundle / "current" / (database + ".dump")).open("rb") as archive:
                proc = subprocess.run(["docker", "exec", "-i", target, "pg_restore", "-U", "app", "-d", database,
                                       "--no-owner", "--no-privileges", "--no-tablespaces", "--exit-on-error",
                                       "--single-transaction"], stdin=archive, capture_output=True, timeout=600)
            if proc.returncode:
                raise RuntimeError("isolated native database restore failed")

    def reject_filetree_race(self, source, config, holder):
        """Use a real PG table-lock barrier, not a guessed sleep, to force ABA."""
        lock = subprocess.Popen(["docker", "exec", "-i", source, "psql", "-X", "-q", "-U",
                                 "postgres", "-d", self.databases[0], "-v", "ON_ERROR_STOP=1"],
                                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        lock.stdin.write(b"SET idle_in_transaction_session_timeout='30s'; BEGIN; LOCK TABLE kopiur_fixture IN ACCESS EXCLUSIVE MODE;\n")
        lock.stdin.flush()
        errors = []
        def mutate_and_release():
            try:
                for _ in range(200):
                    present = run("docker", "exec", holder, "test", "-s",
                                  "/config/.kopiur-postgres/pending/filetree.before", check=False)
                    if not present.returncode:
                        break
                    time.sleep(0.05)
                else:
                    raise RuntimeError("capture never reached the stable-tree checkpoint")
                run("docker", "exec", holder, "sh", "-ec",
                    "printf changed > /config/k8s92-private-fixture.bin; printf native-private-proof > /config/k8s92-private-fixture.bin")
            except Exception as error:
                errors.append(error)
            finally:
                lock.stdin.write(b"COMMIT;\n")
                lock.stdin.close()
        try:
            for _ in range(200):
                held = self.sql(source, "SELECT EXISTS (SELECT 1 FROM pg_locks WHERE relation='kopiur_fixture'::regclass"
                                " AND mode='AccessExclusiveLock' AND granted)", self.databases[0])
                if held == "t":
                    break
                time.sleep(0.05)
            else:
                raise RuntimeError("native lock barrier was not established")
            writer = threading.Thread(target=mutate_and_release)
            writer.start()
            result = self.capture(source, config, self.databases, check=False)
            writer.join(timeout=15)
            assert not writer.is_alive() and not errors
            assert lock.wait(timeout=15) == 0
            assert result != 0, "file rewrite/restore race was accepted as a coherent capture"
            assert run("docker", "exec", holder, "test", "-e", "/config/.kopiur-postgres/COMPLETE", check=False).returncode != 0
        finally:
            if lock.poll() is None:
                lock.kill()
                lock.wait()

    def counts(self, database, name=None):
        name = name or self.databases[0]
        tables = self.sql(database, "SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename", name).splitlines()
        return {table: int(self.sql(database, 'SELECT count(*) FROM public."' + table.replace('"', '""') + '"', name)) for table in tables}

    def fingerprints(self, database, name):
        """Compare restored table contents without printing application records."""
        return {table: hashlib.sha256(self.sql(
            database, 'SELECT row_to_json(t)::text FROM public."' + table.replace('"', '""') +
            '" t ORDER BY row_to_json(t)::text', name).encode()).hexdigest()
                for table in self.counts(database, name)}

    def close(self):
        failures = []
        for name in reversed(self.containers[:]):
            if run("docker", "rm", "-fv", name, check=False).returncode:
                # Failed docker run may not have created a container at all.
                existing = run("docker", "container", "ls", "-aq", "--filter", "name=^/" + name + "$", check=False)
                if existing.returncode or existing.stdout.strip():
                    failures.append(name)
                    continue
            self.containers.remove(name)
        for name in self.volumes:
            if run("docker", "volume", "rm", name, check=False).returncode:
                failures.append(name)
        if failures:
            raise RuntimeError("disposable resource cleanup failed")


def fixture(app_name="radarr"):
    drill = DockerDrill(app_name, diagnostics=True)
    scratch = Path.home() / ".hermes/cache/scratch"
    scratch.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="k8s92-pg-", dir=scratch) as temporary:
        base = Path(temporary)
        try:
            config = drill.config_volume("source-config")
            source = drill.database("source-db", drill.databases)
            holder = drill.start("source-config-holder", PG_IMAGE, user="568:568", mounts=[(config, "/config", "rw")], command=["sleep", "infinity"])
            run("docker", "exec", "--user", "0", holder, "chown", "568:568", "/config")
            app = drill.app("source-app", source, config)
            drill.healthy(app)
            run("docker", "stop", "-t", "30", app)
            if app_name in PAIRED_APPS:
                run("docker", "exec", holder, "sh", "-ec",
                    "umask 077; printf native-private-proof > /config/k8s92-private-fixture.bin")
            before = {}
            for database in drill.databases:
                # Require actual application migrations before adding synthetic markers.
                native = drill.counts(source, database)
                assert native, "application did not create PostgreSQL schema"
                drill.sql(source, "CREATE TABLE kopiur_fixture (id integer primary key, value text NOT NULL);"
                          " INSERT INTO kopiur_fixture VALUES (1, 'native-recovery-proof');", database, "app")
                if app_name != "bazarr":
                    drill.provision_scoped_backup(source, database)
                else:
                    drill.provision_bazarr_backup(source)
                before[database] = drill.counts(source, database)
            held_app = None
            if app_name == "radarr":
                assert run("docker", "inspect", "-f", "{{.State.Running}}", app).stdout.strip() == b"false"
                # A shorter fixture deadline exercises the same fixed 30-minute
                # maximum. It is not a production capture/retention policy.
                hold_until = int(time.time()) + 60
                held_app = drill.app("quiescent-app", source, config, quiesce_until=hold_until)
                for _ in range(20):
                    if drill.check_quiescence(held_app, hold_until, minimum=10):
                        break
                    time.sleep(0.2)
                else:
                    raise RuntimeError("Radarr did not enter the bounded startup hold")
                assert run("docker", "exec", held_app, "curl", "-fsS", "--max-time", "2",
                           f"http://127.0.0.1:{drill.port}/ping", check=False).returncode != 0
            drill.capture(source, config, drill.databases)
            helper = drill.containers[-1]
            if held_app:
                assert drill.check_quiescence(held_app, hold_until), "application resumed before coherent capture completed"
                drill.healthy(held_app)
                assert int(time.time()) >= hold_until, "native Radarr resumed before the fixed expiry"
                assert not drill.check_quiescence(held_app, hold_until), "capture guard accepted a resumed application"
                run("docker", "stop", "-t", "30", held_app)
            bundle = base / "bundle"
            run("docker", "cp", helper + ":/config/.kopiur-postgres", str(bundle))
            assert verify_bundle(bundle) == drill.databases
            target = drill.database("restore-db", drill.databases)
            drill.restore(target, bundle, drill.databases)
            assert {db: drill.counts(target, db) for db in drill.databases} == before, "table counts differ after restore"
            restored = drill.config_volume("restored-config")
            holder = drill.start("config-copy", PG_IMAGE, user="568:568", mounts=[(restored, "/config", "rw")], command=["sleep", "infinity"])
            copied = base / "source-config"
            run("docker", "cp", helper + ":/config", str(copied))
            run("docker", "cp", str(copied) + "/.", holder + ":/config")
            run("docker", "exec", "--user", "0", holder, "chown", "-R", "568:568", "/config")
            restored_app = drill.app("restored-app", target, restored)
            drill.healthy(restored_app)
            for database in drill.databases:
                value = drill.sql(target, "SELECT value FROM kopiur_fixture WHERE id=1", database, "app")
                assert value == "native-recovery-proof"
            if app_name in PAIRED_APPS:
                drill.reject_filetree_race(source, config, helper)
                drill.capture(source, config, drill.databases)
            assert drill.capture(source, config, drill.databases, password="wrong-fixture-password", check=False) != 0
            assert run("docker", "exec", helper, "test", "-e", "/config/.kopiur-postgres/COMPLETE", check=False).returncode != 0
            drill.capture(source, config, drill.databases)
            assert drill.capture(source, config, drill.databases, user="postgres", password=drill.password, check=False) != 0
            assert run("docker", "exec", helper, "test", "-e", "/config/.kopiur-postgres/COMPLETE", check=False).returncode != 0
            # Missing one requested database must reject the entire multi-DB set.
            assert drill.capture(source, config, drill.databases + ["missing_database"], check=False) != 0
            assert run("docker", "exec", helper, "test", "-e", "/config/.kopiur-postgres/COMPLETE", check=False).returncode != 0
            drill.capture(source, config, drill.databases)
            drill.sql(source, f"REVOKE SELECT ON kopiur_fixture FROM {drill.capture_user}", drill.databases[0])
            assert drill.capture(source, config, drill.databases, check=False) != 0
            assert run("docker", "exec", helper, "test", "-e", "/config/.kopiur-postgres/COMPLETE", check=False).returncode != 0
            drill.sql(source, f"GRANT SELECT ON kopiur_fixture TO {drill.capture_user}", drill.databases[0])
            if app_name in PAIRED_APPS:
                # The later CSI view must not replace the paired state generation.
                (copied / "k8s92-private-fixture.bin").write_bytes(b"later-unpaired-state")
            recovered = restore_pvc(copied, app_name, config_mib=256, database_mib=512)
            assert recovered["native_restore"] and recovered["restored_app_ping"]
            recurring = None
            if app_name == "radarr":
                import runpy
                recurring_module = runpy.run_path(str(ROOT / "scripts/kopiur-radarr-recurring-drill.py"))
                recurring = recurring_module["qualify"](drill, source, config, run, PG_IMAGE)
            print(json.dumps({"fixture": app_name + "-native-pg-plus-config", "status": "passed", "databases": len(before),
                              "recurring_radarr": recurring,
                              "tables_equal": sum(len(tables) for tables in before.values()),
                              "rows_equal": sum(sum(tables.values()) for tables in before.values()), "restored_app_ping": True, "restored_fixture_read": True,
                              "stale_success_rejected": True, "superuser_rejected": True, "restore_pvc_drill": True,
                              "dedicated_grant_sql_exercised": True,
                              "bounded_radarr_pause_and_native_resume": held_app is not None,
                              "future_table_read_and_unrelated_data_write_denial": True,
                              "filetree_aba_rejected": app_name in PAIRED_APPS,
                              "paired_filetree_bytes_equal": recovered.get("paired_filetree_bytes_equal", 0),
                              "network": "none-shared-namespace", "production_data": False}, sort_keys=True))
        finally:
            drill.close()


def validate_bazarr_api(response, expected, table, key, sql):
    if (table, key) not in (("table_shows", "sonarrSeriesId"), ("table_movies", "radarrId")):
        raise ValueError("unexpected Bazarr API contract")
    if response["total"] != expected or len(response["data"]) != min(1, expected):
        raise ValueError("restored API count differs from native data")
    if expected:
        record = response["data"][0]
        identity = record[key]
        if type(identity) is not int:
            raise ValueError("restored API record has an invalid identity")
        query = f'''SELECT json_build_object('title', "title", 'path', "path")
                    FROM public."{table}" WHERE "{key}"={identity}'''
        raw = sql(query)
        if not raw or json.loads(raw) != {field: record[field] for field in ("title", "path")}:
            raise ValueError("restored API record differs from native data")
    return {"total": expected, "representative_record_equal": bool(expected),
            "compared_fields": ["identity", "title", "path"] if expected else []}


def validate_radarr_api(response, expected, sql):
    if not isinstance(response, list) or len(response) != expected:
        raise ValueError("restored Radarr API count differs from native data")
    records = []
    for record in response:
        if type(record.get("id")) is not int or type(record.get("tmdbId")) is not int:
            raise ValueError("restored Radarr API identity is invalid")
        records.append({key: record[key] for key in ("id", "tmdbId", "title", "path")})
    original = json.loads(sql('''SELECT coalesce(json_agg(json_build_object(
        'id', m."Id", 'tmdbId', mm."TmdbId", 'title', mm."Title", 'path', m."Path")), '[]'::json)
        FROM "Movies" m JOIN "MovieMetadata" mm ON mm."Id"=m."MovieMetadataId"'''))
    if sorted(records, key=lambda row: row["id"]) != sorted(original, key=lambda row: row["id"]):
        raise ValueError("restored Radarr API records differ from native data")
    encoded = json.dumps(sorted(records, key=lambda row: row["id"]), sort_keys=True).encode()
    return {"movies": expected, "native_records_equal": len(records),
            "native_records_sha256": hashlib.sha256(encoded).hexdigest()}


def restore_pvc(source, app_name, *, config_mib=1024, database_mib=4096, memory_mib=None):
    """Read a recovered PVC. Write only new, isolated Docker resources."""
    source = Path(source)
    if source.is_symlink() or not source.is_dir():
        raise ValueError("source must be a recovered PVC directory, not a symlink")
    bundle = source / ".kopiur-postgres"
    databases = verify_bundle(bundle)
    metadata = (bundle / "current/metadata").read_text().splitlines()
    if app_name in PAIRED_APPS and not (
            "format=2" in metadata and
            "consistency=single-db-stable-filetree" in metadata):
        raise ValueError(app_name + " requires the paired stable-filetree recovery contract")
    drill = DockerDrill(app_name, config_mib=config_mib, database_mib=database_mib, memory_mib=memory_mib)
    if databases != drill.databases:
        raise ValueError("archive database set does not match the selected application")
    # Reject links before streaming. Never follow restored links into host files.
    for path in source.rglob("*"):
        if path.is_symlink() or not (path.is_dir() or path.is_file()):
            raise ValueError("recovered PVC contains links or special files")
    try:
        target = drill.database("restore-db", databases)
        drill.restore(target, bundle, databases)
        counts = {db: drill.counts(target, db) for db in databases}
        fingerprints = {db: drill.fingerprints(target, db) for db in databases}
        if any(not tables for tables in counts.values()):
            raise ValueError("restored database schema is empty")
        # A valid log database can contain zero rows. Require main-app data only.
        if not sum(counts[databases[0]].values()):
            raise ValueError("restored main database is empty")
        config = drill.config_volume("restored-config")
        holder = drill.start("config-copy", PG_IMAGE, user="568:568", mounts=[(config, "/config", "rw")], command=["sleep", "infinity"])
        # Do not copy prior dump generations into the running application's volume.
        process = subprocess.Popen(["docker", "exec", "-i", holder, "tar", "--no-same-owner", "-xf", "-", "-C", "/config"],
                                   stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            with tarfile.open(fileobj=process.stdin, mode="w|") as archive:
                paired = bundle / "current/application-state.tar"
                if paired.is_file():
                    with tarfile.open(paired, mode="r:") as original:
                        validate_tree_members(original, config_mib * 1024 * 1024)
                    with tarfile.open(paired, mode="r:") as original:
                        for member in original:
                            data_file = original.extractfile(member) if member.isfile() else None
                            try:
                                archive.addfile(member, data_file)
                            finally:
                                if data_file is not None:
                                    data_file.close()
                else:
                    for path in sorted(source.iterdir()):
                        if path.name != ".kopiur-postgres":
                            archive.add(path, arcname=path.name, recursive=True)
                # Prefer the config bytes paired with this DB export over later PVC bytes.
                data = drill.isolated_config((bundle / "current/application-config").read_bytes())
                member = tarfile.TarInfo(str(Path(drill.config_file).relative_to("/config")))
                member.size, member.mode, member.uid, member.gid = len(data), 0o600, 568, 568
                archive.addfile(member, io.BytesIO(data))
        finally:
            process.stdin.close()
            try:
                result = process.wait(timeout=120)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
                raise
        if result:
            raise RuntimeError("isolated config import failed; check --config-mib capacity")
        paired_count = 0
        if paired.is_file():
            expected_files = {}
            with tarfile.open(paired, mode="r:") as original:
                for member in original:
                    if member.isfile():
                        with original.extractfile(member) as data_file:
                            expected_files[str(Path(member.name))] = hashlib.file_digest(data_file, "sha256").hexdigest()
            expected_files[str(Path(drill.config_file).relative_to("/config"))] = hashlib.sha256(data).hexdigest()
            observed = run("docker", "exec", holder, "find", "/config", "-type", "f", "-exec", "sha256sum", "-z", "{}", "+")
            observed_files = {}
            for record in observed.stdout.split(b"\0"):
                if record:
                    digest, name = record.split(b"  ", 1)
                    observed_files[str(Path(os.fsdecode(name)).relative_to("/config"))] = digest.decode("ascii")
            if observed_files != expected_files:
                raise ValueError("paired application file bytes differ after isolated restore")
            paired_count = len(expected_files)
        restored_app = drill.app("restored-app", target, config)
        drill.healthy(restored_app)
        api = {}
        if app_name in ("bazarr", "radarr"):
            target_info = json.loads(run("docker", "inspect", target).stdout)[0]
            app_info = json.loads(run("docker", "inspect", restored_app).stdout)[0]
            if target_info["HostConfig"]["NetworkMode"] != "none" or \
                    app_info["HostConfig"]["NetworkMode"] != "container:" + target_info["Id"] or \
                    target_info["HostConfig"].get("PortBindings") or app_info["HostConfig"].get("PortBindings"):
                raise ValueError("restored application is not network isolated")
            endpoints = (("series", "table_shows", "sonarrSeriesId"),
                         ("movies", "table_movies", "radarrId")) if app_name == "bazarr" else ()
            for endpoint, table, key in endpoints:
                response = json.loads(run("docker", "exec", restored_app, "curl", "-fsS",
                    "-H", "X-API-KEY: " + drill.api_key,
                    f"http://127.0.0.1:{drill.port}/api/{endpoint}?length=1").stdout)
                expected = counts["bazarr"][table]
                api[endpoint] = validate_bazarr_api(response, expected, table, key,
                    lambda query: drill.sql(target, query, "bazarr"))
        if app_name == "radarr":
            curl_config = (f'url = "http://127.0.0.1:{drill.port}/api/v3/movie"\n'
                           f'header = "X-Api-Key: {drill.api_key}"\n')
            response = json.loads(run("docker", "exec", "-i", restored_app, "curl", "-fsS", "--config", "-",
                                      stdin=curl_config.encode()).stdout)
            api = validate_radarr_api(response, counts["radarr_main"]["Movies"],
                                      lambda query: drill.sql(target, query, "radarr_main"))
        return {"app": app_name, "native_restore": True, "restored_app_ping": True,
                "database_count": len(databases), "tables": sum(len(t) for t in counts.values()),
                "rows": sum(sum(t.values()) for t in counts.values()), "paired_filetree_bytes_equal": paired_count,
                "table_counts": counts, "table_fingerprints": fingerprints, "api": api,
                "network": "none-shared-namespace"}
    finally:
        drill.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fixture", action="store_true")
    parser.add_argument("--verify-bundle", type=Path)
    parser.add_argument("--restore-pvc", type=Path)
    parser.add_argument("--config-mib", type=int, default=1024)
    parser.add_argument("--database-mib", type=int, default=4096)
    parser.add_argument("--app", choices=CONTRACTS, default="radarr")
    args = parser.parse_args()
    if sum((args.fixture, bool(args.verify_bundle), bool(args.restore_pvc))) != 1:
        parser.error("choose --fixture, --verify-bundle, or --restore-pvc")
    if args.config_mib < 64 or args.database_mib < 128:
        parser.error("config requires at least 64 MiB and database 128 MiB")
    if args.fixture:
        fixture(args.app)
    elif args.restore_pvc:
        print(json.dumps(restore_pvc(args.restore_pvc, args.app, config_mib=args.config_mib, database_mib=args.database_mib), sort_keys=True))
    else:
        databases = verify_bundle(args.verify_bundle)
        print(json.dumps({"bundle_verified": True, "database_count": len(databases)}))


if __name__ == "__main__":
    main()
