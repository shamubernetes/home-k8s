{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      description: "Cowbell chart promotion is managed by its signed webhook",
      matchFileNames: ["kubernetes/apps/services/cowbell/app/ocirepository.yaml"],
      enabled: false,
    },
    {
      description: "Ignore Vector's container image metadata field",
      matchFileNames: ["kubernetes/apps/observability/vector/app/agent/resources/vector.yaml"],
      matchPackageNames: ["container_image"],
      enabled: false,
    },
    {
      description: "Homebrew Actions uses a custom CalVer manager",
      matchManagers: ["github-actions"],
      matchPackageNames: ["Homebrew/actions"],
      enabled: false,
    },
    {
      description: "GitHub Actions Python versions are not digest-pinnable",
      matchManagers: ["github-actions"],
      matchPackageNames: ["actions/python-versions"],
      pinDigests: false,
    },
    {
      description: "Flux OCI sources update tags without synthesizing digest fields",
      matchManagers: ["flux"],
      matchFileNames: ["**/ocirepository.yaml"],
      pinDigests: false,
    },
    {
      description: "Flux manages OCIRepository dependencies without regex duplication",
      matchManagers: ["custom.regex"],
      matchFileNames: ["**/ocirepository.yaml"],
      enabled: false,
    },
    // Allowed Versions
    {
      "description": "PostgreSQL 17",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "docker.io/library/postgres",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/home-operations/postgres-init",
      ],
      "allowedVersions": "<18"
    },
    {
      "description": "TubeArchivist requires Elasticsearch 8",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.elastic.co/elasticsearch/elasticsearch"],
      "allowedVersions": "<9",
    },
    {
      "description": "Rook 1.20.3 is incompatible with Ceph 20.2.3",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/ceph/ceph"],
      "allowedVersions": "<20.2.3",
    },
    // Versions
    {
      "description": ["Custom versioning for http-https-echo"],
      "matchDatasources": ["docker"],
      "versioning": "regex:^(?<major>\\d+)$",
      "matchPackageNames": ["/mendhak/http-https-echo/"],
    },
    {
      "description": ["Loose versioning for plex"],
      "matchDatasources": ["docker"],
      "versioning": "loose",
      "matchPackageNames": ["/plex/"]
    },
    // Groups
    {
      "description": ["Actions Runner Controller Group"],
      "groupName": "Actions Runner Controller",
      "matchPackageNames": ["/gha-runner-scale-set/"],
      "matchDatasources": ["docker", "helm"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": "Cilium image and chart",
      "groupName": "cilium",
      "matchDepNames": [
        "quay.io/cilium/cilium",
        "quay.io/cilium/charts/cilium",
        "quay.io/cilium/operator-generic",
        "cilium",
      ],
      "matchDatasources": ["helm", "docker", "helmfile"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": true,
    },
    {
      "description": "CloudNativePG chart and operator image",
      "groupName": "cloudnative-pg",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/charts/cloudnative-pg",
        "ghcr.io/cloudnative-pg/cloudnative-pg",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": false,
    },
    {
      "description": "External Secrets chart and workload image",
      "groupName": "external-secrets",
      "matchPackageNames": [
        "ghcr.io/external-secrets/charts/external-secrets",
        "ghcr.io/external-secrets/external-secrets",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": false,
    },
    {
      "description": "cert-manager chart and workload images",
      "groupName": "cert-manager",
      "matchPackageNames": [
        "quay.io/jetstack/charts/cert-manager",
        "quay.io/jetstack/cert-manager-controller",
        "quay.io/jetstack/cert-manager-webhook",
        "quay.io/jetstack/cert-manager-cainjector",
        "quay.io/jetstack/cert-manager-startupapicheck",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 5,
      "separateMinorPatch": false,
    },
    {
      "description": "Node Feature Discovery chart and workload image",
      "groupName": "node-feature-discovery",
      "matchPackageNames": [
        "registry.k8s.io/nfd/charts/node-feature-discovery",
        "registry.k8s.io/nfd/node-feature-discovery",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": false,
    },
    {
      "description": "Snapshot Controller chart and workload images",
      "groupName": "snapshot-controller",
      "matchPackageNames": [
        "ghcr.io/piraeusdatastore/helm-charts/snapshot-controller",
        "registry.k8s.io/sig-storage/snapshot-controller",
        "registry.k8s.io/sig-storage/snapshot-conversion-webhook",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "separateMinorPatch": false,
    },
    {
      "description": "Loki chart and workload images",
      "groupName": "loki",
      "matchPackageNames": [
        "ghcr.io/grafana/helm-charts/loki",
        "docker.io/grafana/loki",
        "docker.io/grafana/loki-canary",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 3,
      "separateMinorPatch": true,
    },
    {
      "description": "Prometheus Operator CRDs chart sources",
      "groupName": "prometheus-operator-crds",
      "matchPackageNames": [
        "prometheus-operator-crds",
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds",
      ],
      "matchDatasources": ["helm", "docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": true,
    },
    {
      "description": "Envoy Gateway image and chart",
      "groupName": "envoy-gateway",
      "matchPackageNames": [
        "docker.io/envoyproxy/gateway",
        "docker.io/envoyproxy/gateway-helm",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": true,
    },
    {
      "description": "MariaDB Operator and CRDs charts",
      "groupName": "mariadb-operator",
      "matchPackageNames": [
        "ghcr.io/mariadb-operator/charts/mariadb-operator",
        "ghcr.io/mariadb-operator/charts/mariadb-operator-crds",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": true,
    },
    {
      "description": "Git Mirror Operator release artifacts",
      "groupName": "git-mirror-operator",
      "matchPackageNames": [
        "ghcr.io/shamubernetes/charts/git-mirror-operator",
        "ghcr.io/shamubernetes/git-mirror-operator",
        "ghcr.io/shamubernetes/git-mirror-sync",
      ],
      "matchDatasources": ["docker"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 3,
      "separateMinorPatch": true,
    },
    {
      "description": "Convex runtime image digests",
      "groupName": "convex-runtime",
      "matchPackageNames": [
        "ghcr.io/get-convex/convex-backend",
        "ghcr.io/get-convex/convex-dashboard",
      ],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "minimumGroupSize": 2,
    },
    {
      "description": ["CoreDNS Group"],
      "groupName": "coredns",
      "matchPackageNames": ["/coredns/"],
      "matchDatasources": ["helm", "docker", "helmfile"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": true
    },
    {
      "description": ["Kubelet CSR Approver Group"],
      "groupName": "kubelet-csr-approver",
      "matchPackageNames": ["/kubelet-csr-approver/"],
      "matchDatasources": ["helm", "helmfile"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Dragonfly Operator Group"],
      "groupName": "Dragonfly Operator",
      "matchPackageNames": ["/dragonfly(?:db)?.operator/"],
      "matchDatasources": ["docker", "github-releases"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Flux Group"],
      "groupName": "Flux",
      "matchPackageNames": ["/fluxcd/"],
      "matchDatasources": ["docker", "github-tags"],
      "semanticCommitScope": "group",
      "versioning": "semver",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Intel Device Plugins Group"],
      "groupName": "Intel-Device-Plugins",
      "matchPackageNames": ["/intel-device-plugins/"],
      "matchDatasources": ["helm"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Spegel Group"],
      "groupName": "spegel",
      "matchPackageNames": ["/spegel/"],
      "matchDatasources": ["helm", "docker", "helmfile"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Rook-Ceph Group"],
      "groupName": "Rook-Ceph",
      "matchPackageNames": [
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
        "docker.io/rook/ceph",
        "quay.io/cephcsi/ceph-csi-operator",
        "quay.io/ceph/ceph",
      ],
      "matchDatasources": ["docker", "helm"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "minimumGroupSize": 2,
      "separateMinorPatch": true
    },
    {
      "description": ["System Upgrade Controller Group"],
      "groupName": "System Upgrade Controller",
      "matchPackageNames": ["/system-upgrade-controller/"],
      "matchDatasources": ["docker", "github-releases"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Talos Group"],
      "groupName": "Talos",
      "matchPackageNames": [
        "siderolabs/talos",
        "ghcr.io/siderolabs/talosctl"
      ],
      "matchDatasources": ["docker", "github-releases"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}"
      },
      "separateMinorPatch": true
    },
    {
      "description": "Keep Mise and trusted-runner Talosctl releases synchronized",
      "groupName": "Talosctl tooling",
      "matchDepNames": [
        "talosctl",
        "ghcr.io/siderolabs/talosctl",
      ],
      "matchManagers": ["mise", "custom.regex"],
      "semanticCommitScope": "group",
      "separateMinorPatch": false,
    },
    {
      "description": "Thanos Group - mismatched versions",
      "groupName": "Thanos",
      "matchPackageNames": ["/thanos/"],
      "matchDatasources": ["docker", "github-releases", "helm"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "separateMinorPatch": false,
    },
    {
      "description": "Vector Group - mismatched versions",
      "groupName": "Vector",
      "matchPackageNames": ["/vector/"],
      "matchDatasources": ["docker", "github-releases", "helm"],
      "semanticCommitScope": "group",
      "group": {
        "commitMessageTopic": "{{{groupName}}}",
      },
      "separateMinorPatch": false,
    },
    {
      "description": "Non-infrastructure npm dependencies do not wait for release age",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "0 days",
    },
    {
      "description": "Never auto-merge high-blast-radius infrastructure",
      "matchPackageNames": [
        "!docker.io/rook/ceph",
        "!quay.io/cephcsi/ceph-csi-operator",
        "!quay.io/ceph/ceph",
      ],
      "matchFileNames": [
        "talos/**",
        "kubernetes/apps/actions-runner-system/**",
        "kubernetes/apps/cert-manager/**",
        "kubernetes/apps/database/**",
        "kubernetes/apps/external-secrets/**",
        "kubernetes/apps/flux-system/**",
        "kubernetes/apps/kube-system/**",
        "kubernetes/apps/kyverno/**",
        "kubernetes/apps/network/**",
        "kubernetes/apps/observability/prometheus-operator-crds/**",
        "kubernetes/apps/op/**",
        "kubernetes/apps/openebs-system/**",
        "kubernetes/apps/rook-ceph/**",
        "kubernetes/apps/security/**",
        "kubernetes/apps/system-upgrade/**",
        "kubernetes/apps/tailscale/**",
        "kubernetes/apps/volsync-system/**",
        "kubernetes/apps/**/*-crds*/**",
        "kubernetes/apps/**/*-operator*/**",
      ],
      "automerge": false,
    },
    {
      "description": "Never auto-merge application images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "!docker.io/rook/ceph",
        "!quay.io/cephcsi/ceph-csi-operator",
        "!quay.io/ceph/ceph",
      ],
      "automerge": false,
    },
    {
      "description": "Never auto-merge major updates or mixed-risk groups",
      "matchUpdateTypes": ["major"],
      "automerge": false,
    },
    {
      "description": "Wait one day for Talos and Kubernetes releases before Hermes handles their PRs",
      "matchPackageNames": [
        "siderolabs/talos",
        "siderolabs/kubelet"
      ],
      "matchDatasources": ["github-releases"],
      "minimumReleaseAge": "1 day",
      "automerge": false,
    },
    {
      "description": "Grouped OCI charts rely on their atomic partners for release age",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/cilium/charts/cilium",
        "ghcr.io/coredns/charts/coredns",
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds",
        "ghcr.io/mariadb-operator/charts/mariadb-operator",
        "ghcr.io/mariadb-operator/charts/mariadb-operator-crds",
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
        "ghcr.io/shamubernetes/charts/git-mirror-operator",
      ],
      "minimumReleaseAge": "0 days"
    },
  ],
}
