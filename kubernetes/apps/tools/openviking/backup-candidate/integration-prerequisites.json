{
  "application": "openviking",
  "namespace": "tools",
  "registered": false,
  "provisioning_metadata_source": "acceleration-provision-handoff.json",
  "required_secrets": {
    "openviking-kopiur-nas": [
      "KOPIA_PASSWORD",
      "KOPIA_RCLONE_CONFIG"
    ],
    "openviking-kopiur-r2": [
      "KOPIA_PASSWORD",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY"
    ]
  },
  "shared_deadline_delta": {
    "file": "kubernetes/apps/kyverno/kyverno/policies/kopiur-movers.yaml",
    "namespace": "tools",
    "managed_by": "kopiur",
    "activeDeadlineSeconds": 3600,
    "labels": {
      "config": [
        "openviking-native",
        "openviking-nas-smb",
        "openviking-r2"
      ],
      "maintenance": [
        "openviking-nas-smb",
        "openviking-r2"
      ],
      "verify": [
        "openviking-native"
      ],
      "snapshot-replication": [
        "openviking-native-nas-to-r2"
      ]
    },
    "deletion_op": "snapshot-delete-batch"
  },
  "prerequisites_verified": false,
  "production_original_recovery_qualified": false
}
