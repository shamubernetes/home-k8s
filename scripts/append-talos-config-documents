#!/usr/bin/env bash
set -euo pipefail

if (( $# < 2 )); then
  echo "usage: append-talos-config-documents <output-directory> <document>..." >&2
  exit 2
fi

output_directory=$1
shift
found=false
for config in "$output_directory"/*.yaml; do
  [[ -e "$config" ]] || continue
  for document in "$@"; do
    [[ -f "$document" ]]
    printf "%s\n" "" "---" >> "$config"
    command cat "$document" >> "$config"
  done
  found=true
done
[[ "$found" == true ]]
